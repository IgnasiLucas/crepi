@article{Yang2010,
  author = {Yang, Z. and Rannala, B.},
  title = {Bayesian species delimitation using multilocus sequence data},
  journal = {Proceedings of the National Academy of Sciences},
  volume = {107},
  number = {20},
  pages = {9264-9269},
  year = {2010},
  doi = {10.1073/pnas.0913022107},
  note = {They assume the topology of the populations tree is known, as a guide tree. Then, the problem of species delimitation and assignment reduces to what clusters have been genetically isolated long enough to be considered different species. The authors are aware that recent isolation does not necessarily mean speciation. One of the methods they implement explicitly requests from the user a threshold of divergence time beyond which two groups are considered different species. In their words, "the amount of time that genetic isolation must have persisted before we recognize genetically isolated samples as distinct species (rather than subpopulations) [...] is an essential component of a species definition".}
}
@article{Sukumaran2017,
  author = {Sukumaran, J.  and Knowles, L.L.},
  title = {Multispecies coalescent delimits structure, not species},
  journal = {Proceedings of the National Academy of Sciences},
  volume = {114},
  number = {7},
  pages = {1607-1612},
  year = {2017},
  doi = {10.1073/pnas.1607921114},
  note = {The title says it all. True, for the MSC assumes a BSC. However, the MSC must still be appropriate when dealing with sympatric groups. The difficult thing is to differentiate betwee allopatric populations and different speciees.}
}
@article{Huang2018,
  author = {Huang, J.P.},
  year = {2018},
  title = {What have been and what can be delimited as species using molecular data under the multi-species coalescent model? A case study using {H}ercules beetles (Dynastes; Dynastidae)},
  journal = {Insect Systematics and Diversity},
  volume = {2},
  number = {2},
  pages = {3},
  doi = {10.1093/isd/ixy003},
  note = {The amount of data used determines the resolution we have along the speciation continuum. We seem to need 10 times more RAD loci than clasical Sanger loci to reach similar resolution. In his opinion, the resolution provided by one or two Sanger loci is enough to delimit what traditionally are considered "species". If you need at least 5 such loci, then you are dealing with very recent divergence. Thus, he agrees with Sukumaran2017 in that the MSC delimits populations rather than species, if given enough data. However, he acknowledges the importance of such subtle differences in delimiting sympatric populations under radiation, like cyclid fishes.}
}
